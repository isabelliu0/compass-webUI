# Where `npm run dev` proxies /operator. The browser only ever talks to the Vite
# dev server, so this needs no CORS on the policy server.
VITE_PROXY_TARGET=http://10.40.18.80:9000

# Leave VITE_API_BASE empty to use relative paths (the dev proxy above, or
# serving this build from the policy server itself). Set it to call a policy server 
# directly from the browser — a deployed build, a tablet/HMD pointed at the robot.