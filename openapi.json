{
  "openapi": "3.1.0",
  "info": {
    "title": "FastAPI",
    "version": "2.0"
  },
  "paths": {
    "/operator/info": {
      "get": {
        "tags": [
          "operator"
        ],
        "summary": "Info",
        "operationId": "info_operator_info_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OperatorInfo"
                }
              }
            }
          }
        }
      }
    },
    "/operator/state": {
      "get": {
        "tags": [
          "operator"
        ],
        "summary": "State",
        "operationId": "state_operator_state_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OperatorState"
                }
              }
            }
          }
        }
      }
    },
    "/operator/frame": {
      "get": {
        "tags": [
          "operator"
        ],
        "summary": "Frame",
        "description": "Latest steering-camera JPEG. Optional; ``ts`` is a client cache-buster.",
        "operationId": "frame_operator_frame_get",
        "parameters": [
          {
            "name": "ts",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "default": 0.0,
              "title": "Ts"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Latest steering-camera frame",
            "content": {
              "image/jpeg": {}
            }
          },
          "404": {
            "description": "No frame yet"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/operator/select": {
      "post": {
        "tags": [
          "operator"
        ],
        "summary": "Select",
        "operationId": "select_operator_select_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SelectRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SelectResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/operator/pause": {
      "post": {
        "tags": [
          "operator"
        ],
        "summary": "Pause",
        "operationId": "pause_operator_pause_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PauseRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PauseResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Camera": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "width": {
            "type": "integer",
            "title": "Width"
          },
          "height": {
            "type": "integer",
            "title": "Height"
          },
          "K": {
            "items": {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            "type": "array",
            "title": "K",
            "description": "3x3 intrinsics at native resolution"
          },
          "T_pelvis_in_optical": {
            "items": {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            "type": "array",
            "title": "T Pelvis In Optical",
            "description": "4x4 pelvis -> camera optical frame"
          }
        },
        "type": "object",
        "required": [
          "name",
          "width",
          "height",
          "K",
          "T_pelvis_in_optical"
        ],
        "title": "Camera",
        "description": "Steering-camera geometry. Constant for a run (the waist is fixed during\nmanipulation), so a client reads it once and projects locally."
      },
      "Decision": {
        "properties": {
          "kind": {
            "$ref": "#/components/schemas/DecisionKind"
          },
          "hands": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Hands",
            "description": "arm indices this decision is about (0 left, 1 right). Empty means it concerns both hands together -- draw the pair rather than one endpoint. For a gripper event this is the hand actually opening or closing, the only endpoint worth marking."
          }
        },
        "type": "object",
        "required": [
          "kind",
          "hands"
        ],
        "title": "Decision",
        "description": "What the operator is being asked about."
      },
      "DecisionKind": {
        "type": "string",
        "enum": [
          "initial",
          "gripper",
          "inter_hand",
          "static",
          "none"
        ],
        "title": "DecisionKind",
        "description": "Why the robot stopped to ask.\n\nINITIAL     the episode-start decision point.\nGRIPPER     a hand is about to grasp or release.\nINTER_HAND  the inter-hand transform T_LR changed coordination regime. Only the\n            ``--seg-method regime`` segmenter can detect this.\nSTATIC      both arms went still and are about to move again. Under\n            ``--seg-method gripper-static`` this is what stands in for an\n            inter-hand event -- it occupies the same slot in the state machine\n            but is not a T_LR regime change, so it is named for what it is.\nNONE        no boundary at all. Only appears as a mode's ``outcome``: the\n            segmenter found nothing inside that chunk, so the marker is just the\n            end of the preview rather than a decision point."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ModeOption": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id",
            "description": "rank; 0 is dominant and the default on timeout"
          },
          "count": {
            "type": "integer",
            "title": "Count",
            "description": "samples that landed in this cluster (dominance)"
          },
          "trajectory": {
            "$ref": "#/components/schemas/Trajectory"
          },
          "outcome_index": {
            "type": "integer",
            "title": "Outcome Index",
            "description": "row of `trajectory` where this mode's own next decision point lands"
          },
          "outcome": {
            "$ref": "#/components/schemas/Decision",
            "description": "what will be asked at `outcome_index`. The marker sits there, so this -- not `State.decision` -- is what decides how to draw it. `State.decision` is the boundary holding the robot right now; this is the one this mode leads to, and modes can differ."
          }
        },
        "type": "object",
        "required": [
          "id",
          "count",
          "trajectory",
          "outcome_index",
          "outcome"
        ],
        "title": "ModeOption",
        "description": "One entry in the menu offered at a decision point."
      },
      "OperatorInfo": {
        "properties": {
          "api_version": {
            "type": "string",
            "title": "Api Version"
          },
          "arms": {
            "type": "integer",
            "title": "Arms"
          },
          "arm_order": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Arm Order"
          },
          "frame": {
            "type": "string",
            "title": "Frame",
            "description": "reference frame of every 3D point ('pelvis')"
          },
          "position_units": {
            "type": "string",
            "title": "Position Units"
          },
          "time_units": {
            "type": "string",
            "title": "Time Units"
          },
          "fps": {
            "type": "integer",
            "title": "Fps"
          },
          "mode_menu_enabled": {
            "type": "boolean",
            "title": "Mode Menu Enabled"
          },
          "mode_follow_enabled": {
            "type": "boolean",
            "title": "Mode Follow Enabled"
          },
          "decide_timeout_s": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Decide Timeout S",
            "description": "seconds at a decision point before the server auto-resumes. null = untimed: the robot holds until a mode is selected, which is the go-ahead. 0 = no hold at all (the menu just refreshes)."
          },
          "grip_closed_below": {
            "type": "number",
            "title": "Grip Closed Below",
            "description": "gripper width below this counts as closed; the same threshold the server uses to fire grasp/release decision points"
          },
          "camera": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Camera"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "api_version",
          "arms",
          "arm_order",
          "frame",
          "position_units",
          "time_units",
          "fps",
          "mode_menu_enabled",
          "mode_follow_enabled",
          "decide_timeout_s",
          "grip_closed_below",
          "camera"
        ],
        "title": "OperatorInfo",
        "description": "Static description of this server. Read once at connect."
      },
      "OperatorState": {
        "properties": {
          "phase": {
            "$ref": "#/components/schemas/Phase"
          },
          "decision": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Decision"
              },
              {
                "type": "null"
              }
            ],
            "description": "what the menu currently on offer is about. Stays populated after the hold ends, because the menu itself stays selectable until the next boundary replaces it. Null only before the first decision point of an episode."
          },
          "menu_epoch": {
            "type": "integer",
            "title": "Menu Epoch",
            "description": "identifies the current menu; echo it back on select"
          },
          "menu_ready": {
            "type": "boolean",
            "title": "Menu Ready"
          },
          "decide_remaining_s": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Decide Remaining S"
          },
          "selected_mode_id": {
            "type": "integer",
            "title": "Selected Mode Id"
          },
          "mode_follow_active": {
            "type": "boolean",
            "title": "Mode Follow Active"
          },
          "current_ee": {
            "items": {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            "type": "array",
            "title": "Current Ee",
            "description": "[arm] -> [x,y,z] finger-centre now, pelvis frame, metres"
          },
          "current_grip": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "Current Grip",
            "description": "[arm] -> measured gripper width now, in [0,1]"
          },
          "current_plan": {
            "$ref": "#/components/schemas/Trajectory"
          },
          "modes": {
            "items": {
              "$ref": "#/components/schemas/ModeOption"
            },
            "type": "array",
            "title": "Modes"
          }
        },
        "type": "object",
        "required": [
          "phase",
          "menu_epoch",
          "menu_ready",
          "decide_remaining_s",
          "selected_mode_id",
          "mode_follow_active",
          "current_ee",
          "current_plan",
          "modes"
        ],
        "title": "OperatorState",
        "description": "Everything the operator client needs, in one snapshot."
      },
      "PauseRequest": {
        "properties": {
          "paused": {
            "type": "boolean",
            "title": "Paused"
          }
        },
        "type": "object",
        "required": [
          "paused"
        ],
        "title": "PauseRequest"
      },
      "PauseResponse": {
        "properties": {
          "ok": {
            "type": "boolean",
            "title": "Ok"
          },
          "phase": {
            "$ref": "#/components/schemas/Phase"
          }
        },
        "type": "object",
        "required": [
          "ok",
          "phase"
        ],
        "title": "PauseResponse"
      },
      "Phase": {
        "type": "string",
        "enum": [
          "idle",
          "initial_pause",
          "executing",
          "pause_gripper_event",
          "pause_ihtf_event",
          "paused"
        ],
        "title": "Phase",
        "description": "What the robot is doing, from the operator's point of view.\n\nIDLE                 no observations yet (the robot client isn't streaming).\nINITIAL_PAUSE        held at the episode-start decision point, before any motion.\nEXECUTING            rolling out the chosen mode; no decision pending.\nPAUSE_GRIPPER_EVENT  held at a grasp/release decision point. ``State.decision.hands``\n                     says which hand is acting, so a client can mark just that one.\nPAUSE_IHTF_EVENT     held at a decision point about the pair rather than one hand.\n                     ``State.decision.kind`` says which detector fired -- only the\n                     ``regime`` segmenter produces true inter-hand-transform events.\nPAUSED               held by the operator; stays held until ``set_paused(False)``.\n\nThe three PAUSE_/INITIAL_ states are all decision holds and all carry a menu; they\ndiffer only in what the operator is being asked about."
      },
      "SelectRequest": {
        "properties": {
          "mode_id": {
            "type": "integer",
            "title": "Mode Id"
          },
          "menu_epoch": {
            "type": "integer",
            "title": "Menu Epoch",
            "description": "the menu_epoch this pick was made against; a mismatch is rejected as stale rather than applied to a newer menu"
          }
        },
        "type": "object",
        "required": [
          "mode_id",
          "menu_epoch"
        ],
        "title": "SelectRequest"
      },
      "SelectResponse": {
        "properties": {
          "ok": {
            "type": "boolean",
            "title": "Ok"
          },
          "status": {
            "$ref": "#/components/schemas/SelectStatus"
          },
          "selected_mode_id": {
            "type": "integer",
            "title": "Selected Mode Id"
          },
          "menu_epoch": {
            "type": "integer",
            "title": "Menu Epoch"
          },
          "n_modes": {
            "type": "integer",
            "title": "N Modes"
          }
        },
        "type": "object",
        "required": [
          "ok",
          "status",
          "selected_mode_id",
          "menu_epoch",
          "n_modes"
        ],
        "title": "SelectResponse"
      },
      "SelectStatus": {
        "type": "string",
        "enum": [
          "ok",
          "stale_epoch",
          "out_of_range",
          "no_menu",
          "menu_not_ready",
          "disabled"
        ],
        "title": "SelectStatus",
        "description": "Outcome of ``select_mode``."
      },
      "Trajectory": {
        "properties": {
          "points": {
            "items": {
              "items": {
                "items": {
                  "type": "number"
                },
                "type": "array"
              },
              "type": "array"
            },
            "type": "array",
            "title": "Points",
            "description": "[arm][row] -> [x,y,z] finger-centre, pelvis frame, metres"
          },
          "times": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "Times",
            "description": "[row] -> seconds from now. NOT uniformly spaced: the policy predicts on a multi-resolution grid, so interpolate on this rather than assuming a fixed step."
          },
          "grip": {
            "items": {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            "type": "array",
            "title": "Grip",
            "description": "[arm][row] -> gripper width in [0,1] (0 closed, 1 open), on the same rows as `points`. Style the path by hand state; compare against `grip_closed_below` from /operator/info."
          }
        },
        "type": "object",
        "required": [
          "points",
          "times"
        ],
        "title": "Trajectory",
        "description": "A future path through space, one polyline per arm (left, right)."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
